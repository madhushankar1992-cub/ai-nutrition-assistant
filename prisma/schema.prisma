generator client {
  provider = "prisma-client-js"
}

// Postgres (Supabase/Neon) — required for Vercel, whose serverless functions
// have an ephemeral filesystem, and used for Railway too so both deployments
// share one database. See Docs/deployment-plan.md.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Conversation {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  /// Opaque per-browser id from the signed `nk_owner` cookie (lib/session.ts).
  /// Not a user account. Nullable because conversations created before
  /// ownership existed have none; those are claimed by the first browser to
  /// open them, which is the only migration that does not destroy history.
  ownerId   String?
  messages  Message[]

  @@index([ownerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime     @default(now())
  claims         Claim[]
}

model Claim {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id])
  text      String
  // JSON-encoded Citation (document, publisher, year, url, section, page).
  // Null only on refusal paths, which carry no claims.
  source    String?
  // The retrieved chunk this claim was bound to. Referential integrity IS the
  // no-fabrication guarantee at the storage layer: a claim cannot persist a
  // citation to a chunk that does not exist.
  chunkId   String?
}

model EvalRun {
  id            String   @id @default(uuid())
  runAt         DateTime @default(now())
  promptVersion String
  questionId    String
  attemptNumber Int
  answer        String
  claimsJson    String // JSON-encoded array of { text, source }; kept as String (not Json) to avoid touching working eval code
}

// --- Corpus vectors (Milestone 2) ------------------------------------------
// Vectors live in this Postgres via pgvector, not in a hosted vector service.
// Chroma Cloud was the earlier plan and was dropped: it added a third provider
// and a third credential, and its availability is outside our control. pgvector
// puts the index beside the data both deployments already share.
//
// The `embedding vector(384)` column is added by raw SQL in the migration —
// Prisma has no native vector type — and all similarity queries use $queryRaw.
// 384 dimensions is bge-small-en-v1.5; changing the model means a new column
// and a full re-embed, which `configHash` makes detectable.

model Document {
  id          String   @id @default(uuid())
  sourceKey   String   @unique // registry key from lib/corpus/sources.ts
  name        String
  publisher   String
  year        Int // read from INSIDE the document, never from the linking page
  edition     String?
  url         String // reader-facing; what a citation links to
  fileUrl     String // what ingestion fetches
  checksum    String // sha256 — detects a silently changed document
  retrievedAt DateTime @default(now())
  pageCount   Int?
  wordCount   Int?
  licenseNote String?
  chunks      Chunk[]
}

/// Holds one more column than is declared here: `embedding vector(384)`, added
/// by migration 20261003120000_chunk_embedding_vector. Prisma has no vector
/// type, so it cannot be modelled — and `prisma db push` DROPS it, because it
/// diffs against this file and sees a column it does not know about. Use
/// `prisma migrate deploy` on any database holding real chunks.
model Chunk {
  id                String   @id @default(uuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  ordinal           Int
  section           String
  sectionConfidence String // numbered | typographic | inherited
  page              Int
  text              String
  tokenCount        Int
  kind              String // prose | table | references | toc — the last two are never retrieved
  configHash        String // which RetrievalConfig produced this chunk
  createdAt         DateTime @default(now())

  @@unique([documentId, configHash, ordinal])
  @@index([documentId])
  @@index([configHash])
}

// --- Corpus watcher (Milestone 2 groundwork) -------------------------------
// Additive only: nothing above is altered, so one deploy target can still run
// Milestone 1 code against this schema while the other runs new code.
// See Docs/rag-architecture.md §27 for why that matters here.

model CorpusSource {
  key         String           @id // stable registry key from lib/corpus/sources.ts
  name        String
  publisher   String
  year        Int
  edition     String?
  url         String // reader-facing; what a citation links to
  fileUrl     String // what the watcher fetches; differs when a landing page blocks bots
  acquisition String // "fetched" | "manual"
  enabled     Boolean          @default(true)
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  snapshots   CorpusSnapshot[]
}

model CorpusSnapshot {
  id             String       @id @default(uuid())
  sourceKey      String
  source         CorpusSource @relation(fields: [sourceKey], references: [key])
  runId          String?
  run            ScrapeRun?   @relation(fields: [runId], references: [id])
  checkedAt      DateTime     @default(now())
  verdict        String // first_seen | unchanged | changed | edition_mismatch |
  //                      quality_drop | needs_manual_refresh | unreachable | error
  detail         String
  httpStatus     Int?
  contentType    String?
  finalUrl       String?
  byteLength     Int?
  checksum       String? // sha256 of the body; null when nothing was downloaded
  etag           String? // replayed as If-None-Match so an unchanged PDF costs a 304
  lastModified   String?
  pageCount      Int?
  wordCount      Int?
  wordsPerPage   Int?
  lowTextPages   String? // JSON array — pages too sparse to be prose (covers, scans)
  artworkPages   String? // JSON array — many words, no sentences, few digits (diagrams)
  tablePages     String? // JSON array — many words, no sentences, many digits (data tables)
  extractedTitle String?
  extractedYears String? // JSON array — cross-checked against expectYearIn

  @@index([sourceKey, checkedAt])
}

model ScrapeRun {
  id             String           @id @default(uuid())
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?
  trigger        String // "schedule" | "manual" | "api"
  sourcesChecked Int              @default(0)
  changed        Int              @default(0)
  blocked        Int              @default(0)
  failed         Int              @default(0)
  ok             Boolean          @default(false)
  summary        String?
  snapshots      CorpusSnapshot[]
}

model FailureLogEntry {
  id         String   @id @default(uuid())
  evalRunId  String?
  runAt      DateTime @default(now())
  category   String // unsupported_claim | numeric_drift | broken_source | missed_refusal | unhelpful_hedging | invalid_schema
  questionId String?
  detail     String
}
