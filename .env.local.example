# --- Generation (Milestone 1 + 2) -----------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Conversations, eval, corpus watch state -------------------------------
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Vector store: Chroma Cloud (trychroma.com) ----------------------------
# Required by `npm run ingest`. Get these from trychroma.com -> your database
# -> "Connect". In GitHub Actions they are repository secrets of the same name
# (see .github/workflows/corpus-ingest.yml).
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=
CHROMA_COLLECTION=nutrition-guidance

# --- Embeddings ------------------------------------------------------------
# No key needed. Embeddings run locally with BAAI/bge-small-en-v1.5 through
# ONNX (384 dimensions). Groq serves generation only and has no embeddings
# endpoint, so this would otherwise be a second paid provider; running it
# locally keeps it a build dependency instead of a runtime credential.
# The ~130 MB of weights download on first use and are then cached.
